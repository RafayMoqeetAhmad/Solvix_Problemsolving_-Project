{
  "info": {
    "name": "Solvix API",
    "description": "Complete API collection for Solvix Problem Solving App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Problems",
      "item": [
        {
          "name": "Create Problem",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Computer won't start\",\n  \"description\": \"My computer doesn't turn on when I press the power button\",\n  \"category\": \"Technical\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/problems",
              "host": ["{{base_url}}"],
              "path": ["problems"]
            }
          }
        },
        {
          "name": "Get All Problems",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/problems",
              "host": ["{{base_url}}"],
              "path": ["problems"]
            }
          }
        },
        {
          "name": "Rate Problem",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"feedback\": \"Very helpful solution!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/problems/:id/rate",
              "host": ["{{base_url}}"],
              "path": ["problems", ":id", "rate"]
            }
          }
        }
      ]
    },
    {
      "name": "Tutorials",
      "item": [
        {
          "name": "Get All Tutorials",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tutorials",
              "host": ["{{base_url}}"],
              "path": ["tutorials"]
            }
          }
        },
        {
          "name": "Create Tutorial (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"How to Fix WiFi Issues\",\n  \"category\": \"Technical\",\n  \"difficulty\": \"Easy\",\n  \"duration\": \"10 mins\",\n  \"steps\": [\n    \"Check router connection\",\n    \"Restart router\",\n    \"Check device settings\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/tutorials",
              "host": ["{{base_url}}"],
              "path": ["tutorials"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Platform Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/stats",
              "host": ["{{base_url}}"],
              "path": ["admin", "stats"]
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users",
              "host": ["{{base_url}}"],
              "path": ["admin", "users"]
            }
          }
        }
      ]
    }
  ]
}
